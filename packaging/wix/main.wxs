<?xml version="1.0" encoding="utf-8"?>
<!--
  packaging/wix/main.wxs — CloudMount Windows MSI 定义（WiX v3 线 3.14.x）

  裁决锚（gate1）：Q2 = 手写 .wxs + CI 直接 WiX（candle/light，cargo-wix 不采用）；
  Q3 = 写 Machine 级 PATH；Q4 = 安装到 Program Files\CloudMount。
  安装面（A1 扩展——desktop-installers 三件套）：铺 cloudmountd.exe + cloudmount.exe +
  cloudmount-desktop.exe 并写 Machine PATH；两处快捷方式（开始菜单 + 桌面，指向 desktop
  exe，gate1 Q2 裁决）+ 品牌图标（Icon/ARPPRODUCTICON，源自 gen_icons 的 icon.ico）；
  不含服务注册元素（Windows SCM 注册留 cloudmountd 服务子命令由用户自管）；
  per-machine 安装触发 UAC 提权为预期；
  ARP（Add/Remove Programs）卸载条目为 WiX 缺省行为（Name/Version/Manufacturer 自动登记）。

  变量注入（本文件不写死版本号/构建路径）：
    candle -dProductVersion=<tag 去 v 前缀的数值>   —— CI 步由 github.ref_name 适配（WiX 要求数值格式，
                                                       rc 形态 tag 不在发布语义内，prd AC5；校验在 CI 步）
    candle -dBinDir=<含三 exe 与 icon.ico 的目录>  —— CI 传 target/release 的绝对 Windows 路径

  T16 本地冒烟实证留痕（2026-10-15，wixtoolset 3.14.1.20250415 / candle-light 3.14.1.8722；
  裁决与锁修订授权见 decisions.md 2026-10-15 T16 条目）：
    ① LGHT0368：双 File 组件（非 KeyPath 文件带版本资源时）不可用 Guid="*" 自动 GUID
       → 一文件一组件（WiX 最佳实践，对真实产物带/无版本资源均成立）；
    ② ICE80 实证非误报：x64 包下 ICE 将 ProgramFilesFolder 归 32 位标准目录，运行时实测解析
       C:\Program Files (x86)——违背 prd Q4；抑制路线（-sice:ICE80）废弃，改用
       ProgramFiles64Folder 后 light 无需任何 ICE 抑制（全量 ICE 校验保留）；
    ③ x64 落位实测：ProgramFiles64Folder 变体安装 → C:\Program Files\CloudMount\ 双 exe 在位、
       机器 PATH=[INSTALLDIR]、新进程 where 可寻、卸载文件+PATH 全清（T18 判据同源）。

  MINOR⑫（UTF-8 中文元数据风险）：本文件存为 UTF-8 with BOM；中文仅存在于 XML 注释
  （不编入 MSI 字符串表），MSI 可见元数据一律英文，规避 WiX v3 对无 BOM 源按 ANSI
  处理导致的 ARP 描述乱码/报错。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="CloudMount"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="tintac-cn"
      UpgradeCode="{352929D3-65D8-44F7-85CA-DC277E228A49}">
    <!-- UpgradeCode 固定 GUID：生成一次钉死（uuid4，2026-10-15），永不再改——改则升级识别断裂；
         本期不设计升级/迁移语义（prd 非目标）。MajorUpgrade 语义（gate2 准出回填 MINOR 3 留痕）：
         向前升级自动卸旧装新；降级/同版本重装仍被 DowngradeErrorMessage 拦——Release notes
         维持「先卸载再装」提示（prd AC4）。 -->
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Description="CloudMount daemon + CLI (AGPL-3.0)"
        Comments="Installs cloudmountd.exe and cloudmount.exe, adds the install directory to the machine PATH." />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- desktop-installers AC3③：MSI 内嵌品牌图标（源自 gen_icons 单一管线产物 icon.ico，
         经 CI 归集步同置 BinDir）；ARPPRODUCTICON 令 ARP 卸载条目显示品牌图标 -->
    <Icon Id="CloudMountIcon.ico" SourceFile="$(var.BinDir)/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="CloudMountIcon.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <!-- Q4：INSTALLDIR 解析为 C:\Program Files\CloudMount（candle -arch x64 的 64 位标准目录；
             头注②③实证：ProgramFilesFolder 在 x64 包下落 C:\Program Files (x86)，弃用） -->
        <Directory Id="INSTALLDIR" Name="CloudMount" />
      </Directory>
      <!-- desktop-installers Q2：快捷方式两处标准目录（开始菜单 + 桌面；per-machine 解析为公共位置） -->
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="ProductFeature" Title="CloudMount" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <!-- 一文件一组件（WiX 最佳实践，Guid="*" 自动 GUID 前提；范围：daemon + cli + desktop 三件套）。
           T16 冒烟修正留痕：双 File 组件在非 KeyPath 文件带版本资源时触发 LGHT0368（自动 GUID 不适用），
           拆分后对真实产物（带/无版本资源）均成立。 -->
      <Component Id="CloudMountdComponent" Directory="INSTALLDIR" Guid="*">
        <File Id="CloudMountdExeFile" Name="cloudmountd.exe" Source="$(var.BinDir)/cloudmountd.exe" KeyPath="yes" />
      </Component>
      <Component Id="CloudmountCliComponent" Directory="INSTALLDIR" Guid="*">
        <File Id="CloudmountCliExeFile" Name="cloudmount.exe" Source="$(var.BinDir)/cloudmount.exe" KeyPath="yes" />
      </Component>
      <!-- Q3：Machine 级 PATH（新进程/新开终端生效，已开终端不自动刷新——Release notes 提示）；
           System="yes" = 写 HKLM 机器环境变量；卸载随组件移除（非 Permanent）；
           RegistryValue 作组件 KeyPath（含 Environment 元素的组件标准写法，保证组件引用计数可靠） -->
      <Component Id="MachinePathEnv" Directory="INSTALLDIR" Guid="*">
        <Environment Id="UpdateMachinePath" Name="PATH" Value="[INSTALLDIR]" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\CloudMount" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
      </Component>
      <!-- desktop-installers（gate1 A1 三件套）：desktop exe 与 daemon/cli 同铺 INSTALLDIR。
           本组件与 Icon/ARPPRODUCTICON 为 desktop 授权面（installers-yaml T4 修订依据 =
           decisions.md gate1 B1）：daemon/cli 三既有铺放组件保持 desktop-free。 -->
      <Component Id="CloudMountDesktopComponent" Directory="INSTALLDIR" Guid="*">
        <File Id="CloudMountDesktopExeFile" Name="cloudmount-desktop.exe" Source="$(var.BinDir)/cloudmount-desktop.exe" KeyPath="yes" />
      </Component>
      <!-- desktop-installers（gate1 Q2 两处快捷方式）：独立组件——快捷方式置于用户目录
           （开始菜单 + 桌面），KeyPath=HKCU 注册表值（ICE43 模式：含非广告快捷方式的组件
           须以注册表键为 KeyPath；独立成组件同时满足 ICE57 的 per-user/per-machine 不混装）。
           目标指向 desktop exe、图标用品牌 icon.ico；随组件安装/卸载，无孤儿残留（TP-17）。 -->
      <Component Id="CloudMountShortcutsComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="StartMenuCloudMountShortcut" Directory="ProgramMenuFolder" Name="CloudMount" Target="[INSTALLDIR]cloudmount-desktop.exe" WorkingDirectory="INSTALLDIR" Icon="CloudMountIcon.ico" Advertise="no" />
        <Shortcut Id="DesktopCloudMountShortcut" Directory="DesktopFolder" Name="CloudMount" Target="[INSTALLDIR]cloudmount-desktop.exe" WorkingDirectory="INSTALLDIR" Icon="CloudMountIcon.ico" Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\CloudMount" Name="ShortcutsInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
