;; CloudMount native-Rust minifilter installation information.
;;
;; KM-0 shape: empty filter, HSM load-order group, demand start.
;; Before any production distribution:
;;   1. obtain an altitude assignment from Microsoft for the HSM group;
;;   2. sign with an EV certificate and submit to Partner Center/HLK;
;;   3. development machines use testsigning + a self-signed test cert.
;;
;; Class/ClassGuid are the documented FSFilter HSM setup class
;; (`HSM` / {d546500a-2aeb-45f6-9482-f4b1799c3177}); `Group` is the load-order
;; group (FSFilter HSM). They are deliberately different strings.

[Version]
Signature   = "$Windows NT$"
Class       = HSM
ClassGuid   = {d546500a-2aeb-45f6-9482-f4b1799c3177}
Provider    = %ManufacturerName%
CatalogFile = cloudmount.cat
DriverVer   = 10/27/2026,0.1.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
cloudmount.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12 ; %windir%\system32\drivers
DriverFiles = 12

; Architecture-decorated sections are what InfDefaultInstall uses on x64.
; A DefaultInstall-based (non-PnP minifilter) INF is expected to trigger
; infverif warning 1420 ("cannot be processed as Primitive"); that is
; informational for this class of driver.
[DefaultInstall.NTAMD64]
OptionDesc = %ServiceDescription%
CopyFiles = DriverFiles

[DefaultInstall.NTAMD64.Services]
AddService = cloudmount,,cloudmount.Service

[DefaultUninstall.NTAMD64.Services]
DelService = cloudmount,0x200

[DriverFiles]
cloudmount.sys,,,%COPYFLG_ADD_TO_REGISTRY_INF%

[cloudmount.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %12%\cloudmount.sys
Dependencies   = FltMgr
ServiceType    = 2       ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 3       ; SERVICE_DEMAND_START
ErrorControl   = 1       ; SERVICE_ERROR_NORMAL
Group          = "FSFilter HSM"
Altitude       = "189900" ; development altitude; production must request one

[Strings]
ManufacturerName     = "CloudMount Project"
ServiceName          = "CloudMount Filter"
ServiceDescription   = "CloudMount 115 网盘占位符文件系统过滤器（原生 Rust）"
DiskName             = "CloudMount Installation Disk"
COPYFLG_ADD_TO_REGISTRY_INF = 0x00000002
